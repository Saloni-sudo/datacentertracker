{
  "name": "datacentertracker-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "db:migrate": "node src/db/migrate.js",
    "db:migrate:prod": "node --env-file=.env.aiven src/db/migrate.js",
    "db:migrate:source": "node src/db/migrate.js src/db/migrations/001_add_source_to_reports.sql",
    "db:migrate:citation": "node src/db/migrate.js src/db/migrations/002_add_source_citation.sql",
    "db:seed": "node src/db/seeds/seedReports.js",
    "db:seed:prod": "node --env-file=.env.aiven src/db/seeds/seedReports.js",
    "db:create-admin": "node src/db/seeds/createAdmin.js",
    "admin:create:prod": "node --env-file=.env.aiven src/db/seeds/createAdmin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
