PORT=5050

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=datacentertracker

# LocationIQ forward geocoding (free tier key from https://locationiq.com)
LOCATIONIQ_API_KEY=your_locationiq_api_key
# Accounts are assigned a regional endpoint — EU accounts use https://eu1.locationiq.com/v1
LOCATIONIQ_BASE_URL=https://us1.locationiq.com/v1

# Auth — generate a long random JWT_SECRET, e.g. openssl rand -base64 48
JWT_SECRET=your_long_random_jwt_secret
# Used once by `npm run db:create-admin`; the password is hashed, never stored as typed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_strong_password
